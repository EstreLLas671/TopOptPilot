{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TopOptPilot",
  "version": "2.0.2",
  "identifier": "com.idesktop.v2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "TopOptPilot",
      "width": 1440,
      "height": 900,
      "minWidth": 920,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "fullscreen": false,
      "visible": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "工程开发与 AI 科研拓扑优化工作台",
    "longDescription": "TopOptPilot Tauri 桌面工作台，保留 MATLAB 工程链路并接入 Policy 控制的 AI 科研。",
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
