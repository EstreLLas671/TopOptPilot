{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TopOptPilot 演示版",
  "version": "2.1.2",
  "identifier": "com.topoptpilot.desktop.demo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "TopOptPilot 2.1.2 演示版",
      "width": 1440,
      "height": 900,
      "minWidth": 920,
      "minHeight": 640,
      "center": true,
      "resizable": true,
      "fullscreen": false,
      "visible": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "TopOptPilot 四轮实验桌面演示版",
    "longDescription": "TopOptPilot 桌面演示版本，用于完整展示基础实现至四轮深度优化流程。",
    "resources": ["resources/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
